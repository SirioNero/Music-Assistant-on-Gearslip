<resources>
    <string name="tagline">Το Music Assistant στο αυτοκίνητο, μέσω του Gearslip: η μουσική παίζει από το τηλέφωνο και φτάνει στα ηχεία του αυτοκινήτου.</string>
    <string name="label_language">Γλώσσα</string>
    <string name="label_home">Διεύθυνση στο σπίτι</string>
    <string name="label_remote">Διεύθυνση εκτός σπιτιού (προαιρετικά)</string>
    <string name="label_token">Διακριτικό πρόσβασης μακράς διαρκείας (token)</string>
