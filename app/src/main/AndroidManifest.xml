<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- La musica continua a schermo spento: servizio in primo piano, CPU e Wi-Fi svegli mentre suona. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Per il pulsante che chiede di non ottimizzare la batteria: senza, Android può fermare la musica in auto. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Music Assistant sul telefono legge la cartella Music: Xonos lo chiede solo quando lo si scarica o
         lo si avvia. Da Android 13 il permesso è solo per l'audio. -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <application
        android:name=".XonosApp"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Xonos"
        android:usesCleartextTraffic="true">

        <!-- Gearslip elenca tra le app musicali chi ha un MediaBrowserService e questo descrittore. -->
        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />

        <service
            android:name=".playback.PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaLibraryService" />
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>

        <!-- Le copertine per Gearslip, che non apre indirizzi http: le serve l'app stessa. -->
        <provider
            android:name=".playback.ArtworkProvider"
            android:authorities="${applicationId}.art"
            android:exported="true" />

        <!-- L'account di Music Assistant per myCar, che ha Xonos dentro di sé: risponde solo a myCar (vedi AccountProvider). -->
        <provider
            android:name=".data.AccountProvider"
            android:authorities="it.xonos.ma.account"
            android:exported="true" />

        <!-- Il ponte per myCar lasciata fuori da Tailscale: le sue connessioni verso Music Assistant
             passano da qui. Risponde solo a myCar (vedi MyCarBridge). -->
        <service
            android:name=".data.MyCarBridge"
            android:exported="true">
            <intent-filter>
                <action android:name="io.github.sirionero.mycar.BRIDGE" />
            </intent-filter>
        </service>

        <!-- L'app sul telefono: libreria, ricerca, lettore e impostazioni. -->
        <activity
            android:name=".phone.MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
